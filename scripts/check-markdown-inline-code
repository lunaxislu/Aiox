#!/bin/sh
# 좁은 체크: Markdown 전체 정합성 검사가 아니라, 코드펜스 바깥에서 줄 단위 백틱 균형이
# 깨진 의심 라인(= multi-line inline code)만 찾는다.
#
# 배경: 줄바꿈이 든 inline code는 linter가 list continuation indent를 제거할 때 문서
# 구조를 깨뜨린다(stage 7 claude-adapter 회귀). docs/AGENTS.md Code And Test Evidence >
# Inline Code Stability가 이를 금지하며, 이 스크립트는 그 규칙을 편집 후 검증하는 보조
# 도구다(권위 문서가 아니다).
#
# 사용법: scripts/check-markdown-inline-code <file.md> [file.md ...]
# 종료코드: 의심 라인 0 = 0(clean), 1건 이상 = 1.
#
# 주의: 단순 per-line 백틱 홀짝은 코드펜스 구분선(백틱 3개 = 홀수)을 오탐한다.
# 이 스크립트는 코드펜스 블록을 토글로 건너뛰는 fence-aware 방식이다.

if [ "$#" -eq 0 ]; then
    echo "usage: $0 <file.md> [file.md ...]" >&2
    exit 2
fi

awk '
    FNR == 1 { infence = 0 }                          # 파일마다 fence 상태 초기화
    /^[[:space:]]*`{3,}/ { infence = !infence; next }  # 코드펜스 구분선: 토글 후 건너뜀
    infence { next }                                   # 코드펜스 내부: 건너뜀
    {
        n = gsub(/`/, "`")                             # 이 라인의 backtick 수
        if (n % 2 == 1) { print FILENAME ":" FNR ": " $0; found = 1 }
    }
    END { exit (found ? 1 : 0) }
' "$@"
