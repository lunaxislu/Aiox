#!/bin/sh
# 작업 로그 관리 도구.
#
# 이 도구를 한 케이스 때문에 함부로 늘리지 마라. 형식·기록·도구 변경 기준은
# log skill(.claude/skills/log, .codex/skills/log)을 따른다.
#
# 서브커맨드: new / search / audit / set-status

LOG_DIR="logs"

usage() {
    cat <<'EOF'
사용법:
  log new "<주제>" [설명]                          새 로그를 만든다
  log search [검색어] [--status <open|decided|superseded>]   로그를 찾는다
  log audit <파일> [파일...]                        미완료 체크박스 위치를 점검한다
  log set-status <파일> <open|decided|superseded>   로그 상태를 바꾼다
EOF
}

# frontmatter에서 한 키의 값을 읽는다. "키: " 뒤 전체를 값으로(콜론 허용).
read_field() {
    # $1=파일, $2=키
    awk -v key="$2" '
        BEGIN { infm = 0 }
        NR == 1 && $0 == "---" { infm = 1; next }
        infm == 1 && $0 == "---" { exit }
        infm == 1 {
            prefix = key ": "
            if (substr($0, 1, length(prefix)) == prefix) {
                print substr($0, length(prefix) + 1)
                exit
            }
            # 값이 빈 경우("키:")도 처리
            if ($0 == key ":") {
                print ""
                exit
            }
        }
    ' "$1"
}

cmd_new() {
    topic="$1"
    description="$2"

    if [ -z "$topic" ]; then
        echo "주제를 적어 주세요." >&2
        usage >&2
        return 1
    fi

    if [ -z "$description" ]; then
        echo "경고: description이 비어 있어 검색 결과에서 로그를 판별하기 어렵습니다." >&2
    fi

    today=$(date +%Y-%m-%d)

    # 슬러그 만들기. 한글은 그대로 둔다(바이트 단위 자르기 금지).
    # 1) 공백을 하이픈으로
    slug=$(printf '%s' "$topic" | sed 's/[[:space:]]\{1,\}/-/g')
    # 2) 파일시스템에 위험한 문자만 제거: / \ : * ? " < > |
    slug=$(printf '%s' "$slug" | sed 's/[/\\:*?"<>|]//g')
    # 3) 연속 하이픈을 하나로
    slug=$(printf '%s' "$slug" | sed 's/-\{2,\}/-/g')
    # 4) 앞뒤 하이픈 제거
    slug=$(printf '%s' "$slug" | sed 's/^-*//; s/-*$//')
    # 5) 너무 길면 하이픈 기준 앞 6토큰까지만
    slug=$(printf '%s' "$slug" | awk -F- '{
        out = ""
        n = (NF < 6 ? NF : 6)
        for (i = 1; i <= n; i++) {
            if (out == "") out = $i
            else out = out "-" $i
        }
        print out
    }')
    # 6) 비면 숫자로
    if [ -z "$slug" ]; then
        slug=$(date +%s)
    fi

    mkdir -p "$LOG_DIR"

    base="$LOG_DIR/$today-$slug"
    file="$base.md"
    n=2
    while [ -e "$file" ]; do
        file="$base-$n.md"
        n=$((n + 1))
    done

    {
        printf '%s\n' "---"
        printf 'topic: %s\n' "$topic"
        printf 'description: %s\n' "$description"
        printf 'status: open\n'
        printf '%s\n' "---"
        printf '\n'
        printf '## %s · %s\n' "$today" "$topic"
        printf '\n'
    } > "$file"

    printf '%s\n' "$file"
}

cmd_search() {
    query=""
    status_filter=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --status)
                shift
                status_filter="$1"
                ;;
            *)
                if [ -z "$query" ]; then
                    query="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -n "$status_filter" ]; then
        case "$status_filter" in
            open|decided|superseded) ;;
            *)
                echo "상태 값은 open, decided, superseded 중 하나여야 합니다." >&2
                return 1
                ;;
        esac
    fi

    # 검색어 소문자화(대소문자 무시 부분일치용)
    query_lc=$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')

    found=0
    for f in "$LOG_DIR"/*.md; do
        [ -e "$f" ] || continue

        topic=$(read_field "$f" "topic")
        description=$(read_field "$f" "description")
        status=$(read_field "$f" "status")

        if [ -n "$status_filter" ] && [ "$status" != "$status_filter" ]; then
            continue
        fi

        if [ -n "$query" ]; then
            hay=$(printf '%s %s' "$topic" "$description" | tr '[:upper:]' '[:lower:]')
            case "$hay" in
                *"$query_lc"*) ;;
                *) continue ;;
            esac
        fi

        printf '%s  [%s]  %s — %s\n' "$f" "$status" "$topic" "$description"
        found=1
    done

    if [ "$found" -eq 0 ]; then
        echo "맞는 로그 없음"
    fi
}

# fenced code 밖의 실제 미완료 체크박스를 찾는다. 의미를 판정하거나 수정하지 않는다.
find_incomplete() {
    awk '
        function trim_leading(line) {
            sub(/^ {0,3}/, "", line)
            return line
        }

        function fence_run(line, ch,    i) {
            for (i = 1; substr(line, i, 1) == ch; i++) {}
            return i - 1
        }

        FNR == 1 {
            in_fence = 0
            fence_char = ""
            fence_len = 0
            heading = "(소속 ## 블록 없음)"
        }

        {
            candidate = trim_leading($0)

            if (in_fence) {
                run = fence_run(candidate, fence_char)
                rest = substr(candidate, run + 1)
                if (run >= fence_len && rest ~ /^[[:space:]]*$/) {
                    in_fence = 0
                    fence_char = ""
                    fence_len = 0
                }
                next
            }

            first = substr(candidate, 1, 1)
            if (first == "`" || first == "~") {
                run = fence_run(candidate, first)
                if (run >= 3) {
                    in_fence = 1
                    fence_char = first
                    fence_len = run
                    next
                }
            }

            if ($0 ~ /^##[[:space:]]+/) {
                heading = $0
            }

            if ($0 ~ /^[[:space:]]*-[[:space:]]+\[ \]([[:space:]]|$)/) {
                printf "%s:%d: %s\n  %s\n", FILENAME, FNR, heading, $0
            }
        }
    ' "$@"
}

cmd_audit() {
    if [ "$#" -eq 0 ]; then
        echo "점검할 로그 파일을 지정해 주세요." >&2
        usage >&2
        return 1
    fi

    for file in "$@"; do
        if [ ! -f "$file" ]; then
            echo "파일이 없습니다: $file" >&2
            return 1
        fi
    done

    find_incomplete "$@"
}

cmd_set_status() {
    file="$1"
    new_status="$2"

    case "$new_status" in
        open|decided|superseded) ;;
        *)
            echo "상태 값은 open, decided, superseded 중 하나여야 합니다." >&2
            return 1
            ;;
    esac

    if [ ! -f "$file" ]; then
        echo "파일이 없습니다: $file" >&2
        return 1
    fi

    case "$new_status" in
        decided|superseded)
            audit_tmp=$(mktemp 2>/dev/null) || audit_tmp="$file.audit.tmp.$$"
            if ! find_incomplete "$file" > "$audit_tmp"; then
                rm -f "$audit_tmp"
                echo "미완료 체크박스를 검사하지 못했습니다: $file" >&2
                return 1
            fi
            if [ -s "$audit_tmp" ]; then
                echo "미완료 체크박스가 있어 '$new_status' 상태로 바꿀 수 없습니다:" >&2
                cat "$audit_tmp" >&2
                rm -f "$audit_tmp"
                return 1
            fi
            rm -f "$audit_tmp"
            ;;
    esac

    tmp=$(mktemp 2>/dev/null) || tmp="$file.tmp.$$"
    if awk -v newstatus="$new_status" '
        BEGIN { infm = 0; done = 0 }
        NR == 1 && $0 == "---" { infm = 1; print; next }
        infm == 1 && $0 == "---" { infm = 0; print; next }
        infm == 1 && done == 0 && substr($0, 1, 8) == "status: " {
            print "status: " newstatus
            done = 1
            next
        }
        infm == 1 && done == 0 && $0 == "status:" {
            print "status: " newstatus
            done = 1
            next
        }
        { print }
        END { if (done == 0) exit 1 }
    ' "$file" > "$tmp"; then
        mv "$tmp" "$file"
        echo "상태를 '$new_status'로 바꿨습니다: $file"
    else
        rm -f "$tmp"
        echo "status 필드를 찾지 못해 상태를 바꾸지 못했습니다: $file" >&2
        return 1
    fi
}

main() {
    sub="$1"
    [ $# -gt 0 ] && shift

    case "$sub" in
        new)
            cmd_new "$@"
            ;;
        search)
            cmd_search "$@"
            ;;
        audit)
            cmd_audit "$@"
            ;;
        set-status)
            cmd_set_status "$@"
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
