#!/bin/sh
# 세션 시작 onramp. 활성 plan과 로그 next pointer 체인으로 현재 작업 로그 하나를 찾는다.
# 의미를 추론하지 않고 구조 포인터만 따라가며, 모호하거나 깨진 구조에서는 후보를 보여준다.

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 0

log_tool=.agents/skills/log/scripts/log

read_field() {
    awk -v key="$2" '
        NR == 1 && $0 == "---" { infm = 1; next }
        infm && $0 == "---" { exit }
        infm {
            prefix = key ": "
            if (substr($0, 1, length(prefix)) == prefix) {
                print substr($0, length(prefix) + 1)
                exit
            }
        }
    ' "$1"
}

active_plan_steps() {
    find plans -type f -name '*.md' ! -name 'AGENTS.md' 2>/dev/null | sort | while IFS= read -r plan; do
        awk -v plan="$plan" '
            /^```/ { fence = !fence; next }
            !fence && /^- \[>\]/ { print plan "\t" $0 }
        ' "$plan"
    done
}

# next pointer 행동 텍스트를 만든다. 어느 줄이 진짜 pointer인지는 log 도구의
# audit --next(fence-aware)이 식별한 줄 번호로 정한다.
next_text() {
    rt_file=$1
    rt_line=$($log_tool audit --next "$rt_file" 2>/dev/null | awk '
        NR == 1 && match($0, /:[0-9]+: /) { print substr($0, RSTART + 1, RLENGTH - 3); exit }
    ')
    [ -n "$rt_line" ] || return 0
    awk -v target="$rt_line" '
        FNR == target {
            sub(/^[[:space:]]*-[[:space:]]+\[>\][[:space:]]*/, "")
            text = $0
            capture = 1
            next
        }
        capture && /^[[:space:]]+/ {
            cont = $0
            sub(/^[[:space:]]+/, "", cont)
            text = text " " cont
            next
        }
        capture { print text; printed = 1; exit }
        END { if (capture && !printed) print text }
    ' "$rt_file"
}

log_path_from_text() {
    printf '%s\n' "$1" | awk '
        {
            line = $0
            if (match(line, /logs\/[^`[:space:]]+\.md/)) {
                print substr(line, RSTART, RLENGTH)
                exit
            }
        }
    '
}

log_path_from_next() {
    printf '%s\n' "$1" | awk '
        {
            line = $0
            if (match(line, /logs\/[^`[:space:]]+\.md/)) {
                # 분리 로그 포인터는 next pointer의 첫 행동에 둔다. 뒤쪽의 owner 문서나
                # 검토 대상 경로는 작업 목록일 수 있으므로 따라가지 않는다.
                if (RSTART <= 40) print substr(line, RSTART, RLENGTH)
                exit
            }
        }
    '
}

latest_heading() {
    # 날짜 블록(## YYYY-MM-DD …)만 최신 기록으로 본다. ## Work Items 같은 비-날짜
    # 섹션 제목을 최신 블록으로 오인하지 않게 한다.
    awk '/^## [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ { heading = $0 } END { print heading }' "$1"
}

print_log_summary() {
    file=$1
    topic=$(read_field "$file" topic)
    description=$(read_field "$file" description)
    status=$(read_field "$file" status)
    printf -- '- %s  [%s]  %s\n' "$file" "$status" "$topic"
    [ -n "$description" ] && printf '  %s\n' "$description"

    heading=$(latest_heading "$file")
    [ -n "$heading" ] && printf '  latest: %s\n' "${heading#\#\# }"

    next=$(next_text "$file")
    if [ -n "$next" ]; then
        printf '  Next: %s\n' "$next"
    else
        echo "  Next: 없음"
    fi
}

print_open_candidates() {
    open_logs=$($log_tool search --status open 2>/dev/null)
    if [ -z "$open_logs" ] || [ "$open_logs" = "맞는 로그 없음" ]; then
        echo "- 없음. 작업을 시작하면 log skill로 새 로그를 만드세요."
    else
        printf '%s\n' "$open_logs" | sed 's/^/- /'
    fi
}

referenced_open_leaves() {
    open_logs=$($log_tool search --status open 2>/dev/null)
    paths=$(printf '%s\n' "$open_logs" | awk 'NF && $0 != "맞는 로그 없음" { print $1 }')
    edges=""

    for source in $paths; do
        if ! $log_tool audit --next "$source" >/dev/null 2>&1; then
            continue
        fi
        next=$(next_text "$source")
        target=$(log_path_from_next "$next")
        [ -n "$target" ] || continue
        [ -f "$target" ] || continue
        [ "$(read_field "$target" status)" = "open" ] || continue
        edges="$edges$source	$target
"
    done

    printf '%b' "$edges" | awk -F '\t' '
        NF == 2 { outgoing[$1] = 1; incoming[$2] = 1 }
        END {
            for (path in incoming) {
                if (!outgoing[path]) print path
            }
        }
    ' | sort
}

echo "# 작업 onramp"
echo

steps=$(active_plan_steps)
step_count=$(printf '%s\n' "$steps" | awk 'NF { count++ } END { print count + 0 }')

if [ "$step_count" -eq 0 ]; then
    open_logs=$($log_tool search --status open 2>/dev/null)
    open_count=$(printf '%s\n' "$open_logs" | awk 'NF && $0 != "맞는 로그 없음" { count++ } END { print count + 0 }')
    if [ "$open_count" -eq 1 ]; then
        current=$(printf '%s\n' "$open_logs" | awk '{ print $1 }')
        echo "현재 작업 로그:"
        print_log_summary "$current"
    else
        leaves=$(referenced_open_leaves)
        leaf_count=$(printf '%s\n' "$leaves" | awk 'NF { count++ } END { print count + 0 }')
        if [ "$leaf_count" -eq 1 ]; then
            current=$(printf '%s\n' "$leaves" | awk 'NR == 1 { print }')
            echo "현재 작업 경로:"
            echo "- open 로그 next pointer 참조 그래프의 유일한 leaf"
            echo
            echo "현재 작업 로그:"
            print_log_summary "$current"
        else
            echo "현재 작업 후보:"
            print_open_candidates
            echo
            echo "→ 활성 plan이 없고 next pointer 참조 leaf가 하나로 정해지지 않아 자동 선택하지 않았습니다."
        fi
    fi
    exit 0
fi

if [ "$step_count" -ne 1 ]; then
    echo "진행 중 plan 구조 확인 필요:"
    printf '%s\n' "$steps" | awk -F '\t' '{ print "- " $1 " → " $2 }'
    echo
    echo "→ 활성 단계가 여러 개라 현재 작업을 자동 선택하지 않았습니다."
    exit 0
fi

plan=$(printf '%s\n' "$steps" | awk -F '\t' 'NR == 1 { print $1 }')
step=$(printf '%s\n' "$steps" | awk -F '\t' 'NR == 1 { print $2 }')
current=$(log_path_from_text "$step")

if [ -z "$current" ] || [ ! -f "$current" ]; then
    echo "진행 중 plan 포인터 확인 필요:"
    printf -- '- %s → %s\n' "$plan" "$step"
    echo
    echo "→ 활성 단계의 로그 포인터가 없거나 대상이 존재하지 않습니다."
    exit 0
fi

chain=$current
seen="|$current|"
warning=""
depth=0

while [ "$depth" -lt 16 ]; do
    if ! $log_tool audit --next "$current" >/dev/null 2>&1; then
        warning="next pointer 구조가 유효하지 않습니다: $current"
        break
    fi

    next_pointer=$(next_text "$current")
    next=$(log_path_from_next "$next_pointer")
    [ -n "$next" ] || break

    if [ ! -f "$next" ]; then
        warning="next pointer 대상이 존재하지 않습니다: $next"
        break
    fi
    if [ "$(read_field "$next" status)" != "open" ]; then
        warning="next pointer 대상이 open 로그가 아닙니다: $next"
        break
    fi
    case "$seen" in
        *"|$next|"*)
            warning="next pointer 순환을 발견했습니다: $next"
            break
            ;;
    esac

    chain="$chain
$next"
    seen="$seen$next|"
    current=$next
    depth=$((depth + 1))
done

if [ "$depth" -ge 16 ]; then
    warning="next pointer 체인이 16단계를 초과했습니다."
fi

echo "현재 작업 경로:"
printf -- '- %s → %s\n' "$plan" "${step#- [>] }"
printf '%s\n' "$chain" | awk '{ print "- " $0 }'
echo
echo "현재 작업 로그:"
print_log_summary "$current"

if [ -n "$warning" ]; then
    echo
    printf '경고: %s\n' "$warning"
fi

echo
echo "→ 현재 작업 로그의 최신 기록·Work Items·next pointer를 읽고 작업 전 범위를 짧게 보고하세요."
