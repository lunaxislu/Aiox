{
    "name": "@aiox/cli",
    "version": "0.0.0",
    "private": true,
    "bin": {
        "aiox": "./dist/main.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup --config ../../tsup.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config ../../vitest.config.ts"
    },
    "dependencies": {
        "@aiox/adapter-claude": "workspace:*",
        "@aiox/adapter-codex": "workspace:*",
        "@aiox/config": "workspace:*",
        "@aiox/protocol": "workspace:*",
        "@aiox/vendor": "workspace:*",
        "commander": "14.0.3",
        "effect": "4.0.0-rc.117",
        "ws": "8.21.3"
    },
    "devDependencies": {
        "@types/ws": "8.18.1"
    },
    "engines": {
        "node": "^22.16.0 || >=24.11.0"
    }
}
