{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "vite/client"],
        "paths": { "@/*": ["./src/*"] },
        "jsx": "react-jsx",
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts",
        "vitest.config.ts"
    ]
}
