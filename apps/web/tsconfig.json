{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "vite/client"],
        "paths": { "@/*": ["./src/*"] },
        "jsx": "react-jsx",
        // @storybook/react 10.6.0 puts an @ts-expect-error before an `extends`
        // clause, a position tsc rejects, so its own .d.ts cannot pass. Our
        // packages are checked from source in their own typecheck runs, so
        // skipping .d.ts here loses nothing we still verify elsewhere.
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        ".storybook/**/*.ts",
        ".storybook/**/*.tsx",
        "vite.config.ts",
        "vitest.config.ts"
    ]
}
