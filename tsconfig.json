{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "spikes/**/*.ts", "tests/**/*.ts"],
  "exclude": ["legacy", "node_modules", "dist"]
}
