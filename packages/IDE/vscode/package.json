{
    "name": "aiox-yaml",
    "displayName": "AIOX YAML",
    "version": "0.1.0",
    "private": true,
    "description": "Host YAML completion, validation and Agent navigation for AIOX.",
    "categories": [
        "Programming Languages"
    ],
    "license": "UNLICENSED",
    "publisher": "aiox",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "tsup --config ../../../tsup.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config ../../../vitest.config.ts",
        "vscode:prepublish": "pnpm build",
        "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/aiox-yaml.vsix"
    },
    "dependencies": {
        "yaml": "2.8.3"
    },
    "devDependencies": {
        "@types/vscode": "1.96.0",
        "@vscode/vsce": "3.7.1",
        "ajv": "8.20.0"
    },
    "contributes": {
        "yamlValidation": [
            {
                "fileMatch": "**/aiox.yaml",
                "url": "./schemas/aiox.schema.json"
            },
            {
                "fileMatch": "**/aiox.*.yaml",
                "url": "./schemas/aiox.schema.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:yaml"
    ],
    "extensionDependencies": [
        "redhat.vscode-yaml"
    ],
    "extensionKind": [
        "workspace"
    ],
    "engines": {
        "vscode": "^1.96.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    }
}
