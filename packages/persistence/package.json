{
    "name": "@aiox/persistence",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup --config ../../tsup.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config ../../vitest.config.ts",
        "schema:generate": "node --experimental-strip-types scripts/generate-schema.mjs"
    },
    "dependencies": {
        "@aiox/domain": "workspace:*",
        "@aiox/protocol": "workspace:*",
        "@effect/sql-sqlite-node": "4.0.0-rc.117",
        "drizzle-orm": "1.0.0-rc.5-5935859",
        "effect": "4.0.0-rc.117"
    },
    "devDependencies": {
        "drizzle-kit": "1.0.0-rc.5-5935859"
    }
}
