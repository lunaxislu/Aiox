#!/bin/sh
# 작업 로그 관리 도구.
#
# 이 도구는 로그의 구조 검증과 원자적 변환만 담당한다. 기록 의미, 완료/취소/이관
# 판단과 owner 반영 판단은 agent가 수행한다.
#
# 서브커맨드: new / search / audit / set-status / append / items

LOG_DIR="${LOG_DIR:-logs}"

today_date() {
    if [ -n "${LOG_TODAY:-}" ]; then
        printf '%s' "$LOG_TODAY"
    else
        date +%Y-%m-%d
    fi
}

emit_heading() {
    printf '## %s · %s\n' "$1" "$2"
}

FENCE_FUNCS='
function trim_leading(line) { sub(/^ {0,3}/, "", line); return line }
function fence_run(line, ch,   i) { for (i = 1; substr(line, i, 1) == ch; i++) {} return i - 1 }
function fence_skip(line,   candidate, run, rest, first) {
    candidate = trim_leading(line)
    if (in_fence) {
        run = fence_run(candidate, fence_char)
        rest = substr(candidate, run + 1)
        if (run >= fence_len && rest ~ /^[[:space:]]*$/) { in_fence = 0; fence_char = ""; fence_len = 0 }
        return 1
    }
    first = substr(candidate, 1, 1)
    if (first == "`" || first == "~") {
        run = fence_run(candidate, first)
        if (run >= 3) { in_fence = 1; fence_char = first; fence_len = run; return 1 }
    }
    return 0
}
'

usage() {
    cat <<'EOF'
사용법:
  log new "<주제>" [설명]                          새 로그를 만든다
  log search [검색어] [--status <open|decided|superseded>]   로그를 찾는다
  log audit [--next] <파일> [파일...]               미완료 Work Items(--next면 next pointer 불변)를 점검한다
  log set-status <파일> <open|decided|superseded>   로그 상태를 바꾼다
  log append <파일> "<주제>"                        새 날짜 블록 추가(본문은 stdin)
  log items <파일> add "<행동>" [--status open|active]
                                                        W-id Work Item을 추가한다
  log items <파일> set --id Wn --status <상태> [--reason <이유>] [--target <대상>] [--expect <행동>]
                                                        W-id Work Item을 전이한다
      상태: open|active|completed|cancelled|transferred
      규칙: active는 기존 active를 open으로 내린다. cancelled는 reason 필수, transferred는 target·reason 필수.
EOF
}

contains_newline() {
    case "$1" in
        *"
"*) return 0 ;;
        *) return 1 ;;
    esac
}

is_blank() {
    case "$1" in
        *[![:blank:]]*) return 1 ;;
        *) return 0 ;;
    esac
}

read_field() {
    awk -v key="$2" '
        BEGIN { infm = 0 }
        NR == 1 && $0 == "---" { infm = 1; next }
        infm == 1 && $0 == "---" { exit }
        infm == 1 {
            prefix = key ": "
            if (substr($0, 1, length(prefix)) == prefix) {
                print substr($0, length(prefix) + 1)
                exit
            }
            if ($0 == key ":") { print ""; exit }
        }
    ' "$1"
}

validate_frontmatter() {
    awk '
        function trim(s) { gsub(/^[[:space:]]+/, "", s); gsub(/[[:space:]]+$/, "", s); return s }
        NR == 1 { start = ($0 == "---"); infm = start; next }
        infm && $0 == "---" { closed = 1; exit }
        infm {
            c = index($0, ":")
            if (c > 0) {
                key = trim(substr($0, 1, c - 1))
                val = trim(substr($0, c + 1))
                if (key == "topic") { has_topic = 1; topic_val = val }
                else if (key == "description") has_desc = 1
                else if (key == "status") { has_status = 1; status_val = val }
            }
        }
        END {
            if (!start)      { print "시작 구분자(---)가 없습니다"; exit 2 }
            if (!closed)     { print "종료 구분자(---)가 없습니다"; exit 2 }
            if (!has_topic || topic_val == "") { print "topic이 없거나 비어 있습니다"; exit 2 }
            if (!has_desc)   { print "description 키가 없습니다"; exit 2 }
            if (!has_status) { print "status 키가 없습니다"; exit 2 }
            if (status_val != "open") { print "status가 open이 아닙니다(" status_val ")"; exit 2 }
        }
    ' "$1"
}

apply_result() {
    file=$1
    out=$2
    snapshot=$3
    if ! cmp -s "$file" "$snapshot"; then
        echo "원본이 처리 중에 바뀌었습니다(동시 수정 감지). 적용하지 않습니다: $file" >&2
        return 1
    fi
    if ! mv "$out" "$file"; then
        echo "결과 파일 교체에 실패했습니다: $file" >&2
        return 1
    fi
}

with_atomic_output() {
    file=$1
    builder=$2
    shift 2

    dir=$(dirname "$file")
    if ! out_tmp=$(mktemp "$dir/.log-tmp.XXXXXX" 2>/dev/null); then
        echo "대상 디렉터리에 결과 임시 파일을 만들지 못했습니다: $dir" >&2
        return 1
    fi
    if ! snapshot_tmp=$(mktemp 2>/dev/null); then
        echo "원본 스냅샷 임시 파일 생성에 실패했습니다: $file" >&2
        rm -f "$out_tmp"
        return 1
    fi
    if ! cp "$file" "$snapshot_tmp"; then
        echo "원본 스냅샷 생성에 실패했습니다: $file" >&2
        rm -f "$out_tmp" "$snapshot_tmp"
        return 1
    fi
    if ! cp -p "$file" "$out_tmp"; then
        echo "결과 임시 파일 준비에 실패했습니다: $file" >&2
        rm -f "$out_tmp" "$snapshot_tmp"
        return 1
    fi
    if ! "$builder" "$file" "$@" > "$out_tmp"; then
        echo "결과 생성에 실패했습니다: $file" >&2
        rm -f "$out_tmp" "$snapshot_tmp"
        return 1
    fi
    if ! validate_work_item_ids "$out_tmp"; then
        echo "결과 Work Items 구조가 유효하지 않습니다: $file" >&2
        rm -f "$out_tmp" "$snapshot_tmp"
        return 1
    fi
    next_count=$(find_next_pointers "$out_tmp" | awk 'NF { n++ } END { print n + 0 }') || next_count=0
    if [ "$next_count" -gt 1 ]; then
        echo "결과에 next pointer가 ${next_count}개여서 적용하지 않습니다." >&2
        rm -f "$out_tmp" "$snapshot_tmp"
        return 1
    fi
    if apply_result "$file" "$out_tmp" "$snapshot_tmp"; then
        rm -f "$snapshot_tmp"
        return 0
    fi
    rm -f "$out_tmp" "$snapshot_tmp"
    return 1
}

find_incomplete() {
    awk "$FENCE_FUNCS"'
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0; heading = "(소속 ## 블록 없음)" }
        {
            if (fence_skip($0)) next
            if ($0 ~ /^##[[:space:]]+/) heading = $0
            if ($0 ~ /^[[:space:]]*-[[:space:]]+\[( |>)\][[:space:]]+W[0-9]+[[:space:]]+/) {
                printf "%s:%d: %s\n  %s\n", FILENAME, FNR, heading, $0
            }
        }
    ' "$@"
}

find_next_pointers() {
    awk "$FENCE_FUNCS"'
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0 }
        {
            if (fence_skip($0)) next
            if ($0 ~ /^[[:space:]]*-[[:space:]]+\[>\][[:space:]]+W[0-9]+[[:space:]]+/) {
                printf "%d\t%s\n", FNR, $0
            }
        }
    ' "$1"
}

work_items_section_count() {
    awk "$FENCE_FUNCS"'
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0; count = 0 }
        {
            if (fence_skip($0)) next
            if ($0 ~ /^##[[:space:]]+Work Items[[:space:]]*$/) count++
        }
        END { print count + 0 }
    ' "$1"
}

next_work_item_id() {
    awk "$FENCE_FUNCS"'
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0; max = 0 }
        {
            if (fence_skip($0)) next
            line = $0
            while (match(line, /W[0-9]+/)) {
                id = substr(line, RSTART + 1, RLENGTH - 1) + 0
                if (id > max) max = id
                line = substr(line, RSTART + RLENGTH)
            }
        }
        END { printf "W%d\n", max + 1 }
    ' "$1"
}

validate_work_item_ids() {
    LOG_ITEM_TARGET_ID="${2:-}" LOG_ITEM_HAS_EXPECT="${3:-0}" LOG_ITEM_EXPECT="${4:-}" awk "$FENCE_FUNCS"'
        function fail(msg) { print "ITEMS_ERROR: " msg > "/dev/stderr"; failed = 1; exit 1 }
        function parse_item(line,   rest, after) {
            item_id = ""; item_text = ""; item_marker = ""
            if (!match(line, /^[[:space:]]*-[[:space:]]+/)) return 0
            rest = substr(line, RLENGTH + 1)
            if (rest !~ /^\[[ >xX]\][[:space:]]+W[0-9]+([[:space:]]|$)/) return 0
            item_marker = substr(rest, 2, 1)
            after = rest
            sub(/^\[[ >xX]\][[:space:]]+/, "", after)
            item_id = after
            sub(/[[:space:]].*$/, "", item_id)
            item_text = after
            sub(/^W[0-9]+[[:space:]]*/, "", item_text)
            return 1
        }
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0; found = 0 }
        {
            if (fence_skip($0)) next
            if (!parse_item($0)) next
            if (item_id in seen) fail("중복 Work Item id입니다: " item_id)
            seen[item_id] = 1
            if (item_id == ENVIRON["LOG_ITEM_TARGET_ID"]) {
                found = 1
                if (item_marker != " " && item_marker != ">")
                    fail("완료된 Work Item은 다시 전이하지 않습니다: " item_id)
                if (ENVIRON["LOG_ITEM_HAS_EXPECT"] == "1" && item_text != ENVIRON["LOG_ITEM_EXPECT"])
                    fail("--expect가 현재 행동과 일치하지 않습니다: " item_id)
            }
        }
        END {
            if (failed) exit 1
            if (ENVIRON["LOG_ITEM_TARGET_ID"] != "" && !found) {
                print "ITEMS_ERROR: Work Item id를 찾지 못했습니다: " ENVIRON["LOG_ITEM_TARGET_ID"] > "/dev/stderr"
                exit 1
            }
        }
    ' "$1"
}

print_closeout_hint_if_clean() {
    remaining=$(find_incomplete "$1") || return 0
    if [ -z "$remaining" ]; then
        printf '힌트: 미완료 Work Items/next pointer가 없습니다. decided 후보인지 확인하세요: %s\n' "$1"
    fi
}

cmd_new() {
    topic=$1
    description=$2
    if [ -z "$topic" ]; then
        echo "주제를 적어 주세요." >&2
        usage >&2
        return 1
    fi
    if [ -z "$description" ]; then
        echo "경고: description이 비어 있어 검색 결과에서 로그를 판별하기 어렵습니다." >&2
    fi

    today=$(today_date)
    slug=$(printf '%s' "$topic" | sed 's/[[:space:]]\{1,\}/-/g')
    slug=$(printf '%s' "$slug" | sed 's/[/\\:*?"<>|]//g')
    slug=$(printf '%s' "$slug" | sed 's/-\{2,\}/-/g')
    slug=$(printf '%s' "$slug" | sed 's/^-*//; s/-*$//')
    slug=$(printf '%s' "$slug" | awk -F- '{
        out = ""; n = (NF < 6 ? NF : 6)
        for (i = 1; i <= n; i++) { if (out == "") out = $i; else out = out "-" $i }
        print out
    }')
    [ -n "$slug" ] || slug=$(date +%s)

    mkdir -p "$LOG_DIR"
    base="$LOG_DIR/$today-$slug"
    file="$base.md"
    n=2
    while [ -e "$file" ]; do
        file="$base-$n.md"
        n=$((n + 1))
    done

    {
        printf '%s\n' "---"
        printf 'topic: %s\n' "$topic"
        printf 'description: %s\n' "$description"
        printf 'status: open\n'
        printf '%s\n' "---"
        printf '\n'
        printf '## Work Items\n'
        printf '\n'
        emit_heading "$today" "$topic"
        printf '\n'
    } > "$file"

    printf '%s\n' "$file"
}

cmd_search() {
    query=""
    status_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --status)
                shift
                status_filter=$1
                ;;
            *)
                [ -z "$query" ] && query=$1
                ;;
        esac
        shift
    done
    if [ -n "$status_filter" ]; then
        case "$status_filter" in
            open|decided|superseded) ;;
            *) echo "상태 값은 open, decided, superseded 중 하나여야 합니다." >&2; return 1 ;;
        esac
    fi
    query_lc=$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')
    found=0
    for f in "$LOG_DIR"/*.md; do
        [ -e "$f" ] || continue
        topic=$(read_field "$f" topic)
        description=$(read_field "$f" description)
        status=$(read_field "$f" status)
        case "$status" in open|decided|superseded) ;; *) continue ;; esac
        [ -z "$status_filter" ] || [ "$status" = "$status_filter" ] || continue
        if [ -n "$query" ]; then
            hay=$(printf '%s %s' "$topic" "$description" | tr '[:upper:]' '[:lower:]')
            case "$hay" in *"$query_lc"*) ;; *) continue ;; esac
        fi
        printf '%s  [%s]  %s — %s\n' "$f" "$status" "$topic" "$description"
        found=1
    done
    [ "$found" -eq 1 ] || echo "맞는 로그 없음"
}

cmd_audit() {
    next_only=0
    if [ "${1:-}" = "--next" ]; then
        next_only=1
        shift
    fi
    if [ "$#" -eq 0 ]; then
        echo "점검할 로그 파일을 지정해 주세요." >&2
        usage >&2
        return 1
    fi
    for file in "$@"; do
        [ -f "$file" ] || { echo "파일이 없습니다: $file" >&2; return 1; }
    done
    if [ "$next_only" -eq 0 ]; then
        find_incomplete "$@"
        return
    fi
    rc=0
    for file in "$@"; do
        pointers=$(find_next_pointers "$file") || return 1
        count=$(printf '%s\n' "$pointers" | awk 'NF { n++ } END { print n + 0 }')
        case "$count" in
            0) printf '%s: next pointer 없음\n' "$file" ;;
            1) printf '%s\n' "$pointers" | awk -F '\t' -v file="$file" '{ print file ":" $1 ": " $2 }' ;;
            *)
                printf '%s: 미완료 next pointer가 %s개입니다(최대 1개):\n' "$file" "$count" >&2
                printf '%s\n' "$pointers" | awk -F '\t' -v file="$file" '{ print "  " file ":" $1 ": " $2 }' >&2
                rc=1
                ;;
        esac
    done
    return "$rc"
}

cmd_set_status() {
    file=$1
    new_status=$2
    case "$new_status" in open|decided|superseded) ;; *) echo "상태 값은 open, decided, superseded 중 하나여야 합니다." >&2; return 1 ;; esac
    [ -f "$file" ] || { echo "파일이 없습니다: $file" >&2; return 1; }
    case "$new_status" in
        decided|superseded)
            audit_tmp=$(mktemp 2>/dev/null) || audit_tmp="$file.audit.tmp.$$"
            if ! find_incomplete "$file" > "$audit_tmp"; then
                rm -f "$audit_tmp"; echo "미완료 Work Items를 검사하지 못했습니다: $file" >&2; return 1
            fi
            if [ -s "$audit_tmp" ]; then
                echo "미완료 Work Items가 있어 '$new_status' 상태로 바꿀 수 없습니다:" >&2
                cat "$audit_tmp" >&2
                rm -f "$audit_tmp"
                return 1
            fi
            rm -f "$audit_tmp"
            ;;
    esac
    tmp=$(mktemp 2>/dev/null) || tmp="$file.tmp.$$"
    if awk -v newstatus="$new_status" '
        BEGIN { infm = 0; done = 0 }
        NR == 1 && $0 == "---" { infm = 1; print; next }
        infm == 1 && $0 == "---" { infm = 0; print; next }
        infm == 1 && done == 0 && substr($0, 1, 8) == "status: " { print "status: " newstatus; done = 1; next }
        infm == 1 && done == 0 && $0 == "status:" { print "status: " newstatus; done = 1; next }
        { print }
        END { if (done == 0) exit 1 }
    ' "$file" > "$tmp"; then
        mv "$tmp" "$file"
        echo "상태를 '$new_status'로 바꿨습니다: $file"
    else
        rm -f "$tmp"
        echo "status 필드를 찾지 못해 상태를 바꾸지 못했습니다: $file" >&2
        return 1
    fi
}

emit_body() {
    awk '
        {
            if ($0 ~ /^[[:space:]]*$/) {
                if (started) pending = pending "\n"
            } else {
                if (started) printf "%s", pending
                pending = ""
                print
                started = 1
            }
        }
    ' "$1"
}

build_append_result() {
    file=$1
    topic=$2
    body=$3
    awk '
        {
            if ($0 ~ /^[[:space:]]*$/) pending = pending "\n"
            else { if (started) printf "%s", pending; pending = ""; print; started = 1 }
        }
    ' "$file"
    printf '\n'
    emit_heading "$(today_date)" "$topic"
    printf '\n'
    emit_body "$body"
}

cmd_append() {
    file=$1
    topic=$2
    shift 2 2>/dev/null || true
    if [ -z "$file" ] || [ -z "$topic" ]; then
        echo "append에는 파일과 블록 주제가 필요합니다." >&2
        usage >&2
        return 1
    fi
    if [ "$#" -gt 0 ]; then
        echo "append는 추가 옵션을 받지 않습니다." >&2
        return 1
    fi
    if contains_newline "$topic" || is_blank "$topic"; then
        echo "블록 주제는 공백이 아닌 한 줄이어야 합니다." >&2
        return 1
    fi
    [ -f "$file" ] || { echo "파일이 없습니다: $file" >&2; return 1; }
    if ! fm_err=$(validate_frontmatter "$file"); then
        echo "frontmatter가 유효한 open 로그가 아닙니다: $file (${fm_err})" >&2
        return 1
    fi
    body_tmp=$(mktemp 2>/dev/null) || { echo "본문 임시 파일 생성에 실패했습니다." >&2; return 1; }
    cat > "$body_tmp"
    if ! grep -q '[^[:space:]]' "$body_tmp"; then
        echo "본문(stdin)이 비어 있습니다." >&2
        rm -f "$body_tmp"
        return 1
    fi
    body_next=$(find_next_pointers "$body_tmp") || { rm -f "$body_tmp"; return 1; }
    if [ -n "$body_next" ]; then
        echo "본문에 next pointer를 직접 쓸 수 없습니다. items 명령을 사용하세요." >&2
        rm -f "$body_tmp"
        return 1
    fi
    if with_atomic_output "$file" build_append_result "$topic" "$body_tmp"; then
        rm -f "$body_tmp"
        printf '적용했습니다: %s\n' "$file"
        print_closeout_hint_if_clean "$file"
        return 0
    fi
    rm -f "$body_tmp"
    return 1
}

build_items_add_result() {
    file=$1
    id=$2
    status=$3
    action=$4
    marker=" "
    demote=0
    if [ "$status" = "active" ]; then marker=">"; demote=1; fi
    LOG_ITEM_LINE="- [${marker}] ${id} ${action}" LOG_ITEM_DEMOTE_ACTIVE="$demote" awk "$FENCE_FUNCS"'
        function maybe_demote(line) {
            if (ENVIRON["LOG_ITEM_DEMOTE_ACTIVE"] == "1" &&
                line ~ /^[[:space:]]*-[[:space:]]+\[>\][[:space:]]+W[0-9]+[[:space:]]+/) {
                sub(/\[>\]/, "[ ]", line)
            }
            return line
        }
        FNR == 1 {
            in_fence = 0; fence_char = ""; fence_len = 0
            wi_count = 0; wi_start = 0; wi_end = 0; in_wi = 0; fm = 0; fm_close = 0
        }
        {
            skip = fence_skip($0)
            out[NR] = (!skip ? maybe_demote($0) : $0)
            if (NR == 1 && $0 == "---") fm = 1
            else if (fm && $0 == "---" && fm_close == 0) fm_close = NR
            if (!skip && $0 ~ /^##[[:space:]]+Work Items[[:space:]]*$/) {
                wi_count++
                if (wi_count == 1) { wi_start = NR; in_wi = 1 }
            } else if (!skip && in_wi && $0 ~ /^##[[:space:]]+/) {
                wi_end = NR - 1; in_wi = 0
            }
        }
        END {
            if (wi_count == 0) {
                for (i = 1; i <= NR; i++) {
                    print out[i]
                    if (i == fm_close) { print ""; print "## Work Items"; print ENVIRON["LOG_ITEM_LINE"]; print "" }
                }
                exit
            }
            if (wi_end == 0) wi_end = NR
            wi_insert_after = wi_start
            for (i = wi_start + 1; i <= wi_end; i++) if (out[i] !~ /^[[:space:]]*$/) wi_insert_after = i
            for (i = 1; i <= NR; i++) {
                if (i > wi_insert_after && i <= wi_end && out[i] ~ /^[[:space:]]*$/) continue
                print out[i]
                if (i == wi_insert_after) { print ENVIRON["LOG_ITEM_LINE"]; print "" }
            }
        }
    ' "$file"
}

build_items_set_result() {
    file=$1
    id=$2
    status=$3
    reason=$4
    target=$5
    LOG_ITEM_ID="$id" LOG_ITEM_STATUS="$status" LOG_ITEM_REASON="$reason" LOG_ITEM_TARGET="$target" awk "$FENCE_FUNCS"'
        function parse_item(line,   rest, after) {
            item_prefix = ""; item_marker = ""; item_id = ""; item_text = ""
            if (!match(line, /^[[:space:]]*-[[:space:]]+/)) return 0
            item_prefix = substr(line, 1, RLENGTH)
            rest = substr(line, RLENGTH + 1)
            if (rest !~ /^\[[ >xX]\][[:space:]]+W[0-9]+([[:space:]]|$)/) return 0
            item_marker = substr(rest, 2, 1)
            after = rest
            sub(/^\[[ >xX]\][[:space:]]+/, "", after)
            item_id = after
            sub(/[[:space:]].*$/, "", item_id)
            item_text = after
            sub(/^W[0-9]+[[:space:]]*/, "", item_text)
            return 1
        }
        function render(marker, text) { return item_prefix "[" marker "] " item_id " " text }
        FNR == 1 { in_fence = 0; fence_char = ""; fence_len = 0 }
        {
            line = $0
            if (!fence_skip($0) && parse_item($0)) {
                if (item_id == ENVIRON["LOG_ITEM_ID"]) {
                    st = ENVIRON["LOG_ITEM_STATUS"]
                    if (st == "active") line = render(">", item_text)
                    else if (st == "open") line = render(" ", item_text)
                    else if (st == "completed") line = render("x", item_text)
                    else if (st == "cancelled") line = render("x", "Cancelled: " item_text " — " ENVIRON["LOG_ITEM_REASON"])
                    else if (st == "transferred") line = render("x", "Transferred: " item_text " → " ENVIRON["LOG_ITEM_TARGET"] " — " ENVIRON["LOG_ITEM_REASON"])
                } else if (ENVIRON["LOG_ITEM_STATUS"] == "active" && item_marker == ">") {
                    line = render(" ", item_text)
                }
            }
            if (line ~ /^[[:space:]]*$/) {
                pending = pending "\n"
            } else {
                if (started) printf "%s", pending
                pending = ""
                print line
                started = 1
            }
        }
    ' "$file"
}

cmd_items() {
    file=$1
    op=$2
    [ "$#" -ge 1 ] && shift
    [ "$#" -ge 1 ] && shift
    if [ -z "$file" ] || [ -z "$op" ]; then
        echo "items는 파일과 add/set 동작이 필요합니다." >&2
        usage >&2
        return 1
    fi
    [ -f "$file" ] || { echo "파일이 없습니다: $file" >&2; return 1; }
    if ! fm_err=$(validate_frontmatter "$file"); then
        echo "frontmatter가 유효한 open 로그가 아닙니다: $file (${fm_err})" >&2
        return 1
    fi
    wi_count=$(work_items_section_count "$file") || return 1
    if [ "$wi_count" -gt 1 ]; then
        echo "## Work Items 섹션이 여러 개입니다: $file" >&2
        return 1
    fi
    validate_work_item_ids "$file" || return 1

    case "$op" in
        add)
            action=$1
            [ "$#" -ge 1 ] && shift
            status=open
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --status) shift; status=$1 ;;
                    --active) status=active ;;
                    --*) echo "알 수 없는 items add 옵션입니다: $1" >&2; return 1 ;;
                    *) echo "items add 인자가 너무 많습니다: $1" >&2; return 1 ;;
                esac
                shift
            done
            if contains_newline "$action" || is_blank "$action"; then
                echo "items add의 <행동>은 공백이 아닌 한 줄이어야 합니다." >&2
                return 1
            fi
            case "$status" in open|active) ;; *) echo "items add --status는 open 또는 active만 허용합니다." >&2; return 1 ;; esac
            id=$(next_work_item_id "$file") || return 1
            if with_atomic_output "$file" build_items_add_result "$id" "$status" "$action"; then
                printf '적용했습니다: %s\n' "$file"
                printf '추가한 Work Item: %s\n' "$id"
                print_closeout_hint_if_clean "$file"
                return 0
            fi
            return 1
            ;;
        set)
            id=""; status=""; reason=""; target=""; expect=""; has_expect=0
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --id) shift; id=$1 ;;
                    --status) shift; status=$1 ;;
                    --reason) shift; reason=$1 ;;
                    --target) shift; target=$1 ;;
                    --expect) shift; expect=$1; has_expect=1 ;;
                    --*) echo "알 수 없는 items set 옵션입니다: $1" >&2; return 1 ;;
                    *) echo "items set 인자가 너무 많습니다: $1" >&2; return 1 ;;
                esac
                shift
            done
            if ! printf '%s\n' "$id" | grep -q '^W[1-9][0-9]*$'; then
                echo "--id는 W1, W2 같은 형식이어야 합니다." >&2
                return 1
            fi
            case "$status" in open|active|completed|cancelled|transferred) ;; *) echo "--status는 open, active, completed, cancelled, transferred 중 하나여야 합니다." >&2; return 1 ;; esac
            case "$status" in
                open|active|completed)
                    if [ -n "$reason" ] || [ -n "$target" ]; then echo "$status 상태에는 --reason/--target을 줄 수 없습니다." >&2; return 1; fi
                    ;;
                cancelled)
                    if contains_newline "$reason" || is_blank "$reason"; then echo "cancelled 상태에는 공백이 아닌 --reason이 필요합니다." >&2; return 1; fi
                    if [ -n "$target" ]; then echo "cancelled 상태에는 --target을 줄 수 없습니다." >&2; return 1; fi
                    ;;
                transferred)
                    if contains_newline "$reason" || is_blank "$reason"; then echo "transferred 상태에는 공백이 아닌 --reason이 필요합니다." >&2; return 1; fi
                    if contains_newline "$target" || is_blank "$target"; then echo "transferred 상태에는 공백이 아닌 --target이 필요합니다." >&2; return 1; fi
                    ;;
            esac
            if [ "$has_expect" -eq 1 ] && { contains_newline "$expect" || is_blank "$expect"; }; then
                echo "--expect는 공백이 아닌 한 줄이어야 합니다." >&2
                return 1
            fi
            validate_work_item_ids "$file" "$id" "$has_expect" "$expect" || return 1
            if with_atomic_output "$file" build_items_set_result "$id" "$status" "$reason" "$target"; then
                printf '적용했습니다: %s\n' "$file"
                print_closeout_hint_if_clean "$file"
                return 0
            fi
            return 1
            ;;
        *)
            echo "items 동작은 add 또는 set이어야 합니다: $op" >&2
            return 1
            ;;
    esac
}

main() {
    sub=$1
    [ $# -gt 0 ] && shift
    case "$sub" in
        new) cmd_new "$@" ;;
        search) cmd_search "$@" ;;
        audit) cmd_audit "$@" ;;
        set-status) cmd_set_status "$@" ;;
        append) cmd_append "$@" ;;
        items) cmd_items "$@" ;;
        *) usage ;;
    esac
}

if [ -z "${LOG_LIB_ONLY:-}" ]; then
    main "$@"
fi
