{
    "name": "ai-orchestration",
    "version": "1.0.0",
    "private": true,
    "description": "AIOX TUI product rebuild",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "onramp": "scripts/onramp",
        "test:workflow": "scripts/test-onramp.sh",
        "build": "pnpm -r --if-present build",
        "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "lint": "oxlint apps packages tsup.config.ts vitest.config.ts",
        "lint:fix": "oxlint --fix apps packages tsup.config.ts vitest.config.ts",
        "format": "oxfmt --write apps packages package.json tsconfig.json tsconfig.base.json tsup.config.ts vitest.config.ts pnpm-workspace.yaml .oxfmtrc.json .oxlintrc.json .vscode/settings.json",
        "format:check": "oxfmt --check apps packages package.json tsconfig.json tsconfig.base.json tsup.config.ts vitest.config.ts pnpm-workspace.yaml .oxfmtrc.json .oxlintrc.json .vscode/settings.json",
        "check": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test",
        "harness": "pnpm --filter @aiox/daemon harness",
        "react-doctor": "react-doctor --project apps/web"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.0-rc.117",
        "@types/node": "22.20.1",
        "fast-check": "4.10.2",
        "oxfmt": "0.66.0",
        "oxlint": "1.81.0",
        "react-doctor": "^0.9.14",
        "tsup": "8.5.1",
        "typescript": "5.9.3",
        "vitest": "5.0.1"
    },
    "engines": {
        "node": "^22.16.0 || >=24.11.0"
    },
    "packageManager": "pnpm@10.33.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild",
            "node-pty"
        ],
        "patchedDependencies": {
            "tinybench@6.1.4": "patches/tinybench@6.1.4.patch",
            "effect@4.0.0-rc.117": "patches/effect@4.0.0-rc.117.patch",
            "xstate@5.33.2": "patches/xstate@5.33.2.patch",
            "@xterm/xterm@6.1.0-beta.304": "patches/@xterm__xterm@6.1.0-beta.304.patch"
        }
    }
}
